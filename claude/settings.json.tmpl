{
  "model": "opusplan",
  "advisorModel": "opus",
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "__PERMISSION_MODE__",
    "deny": [
      "Read(//mnt/**)",
      "Edit(//mnt/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": ["/mnt"],
      "denyWrite": ["/mnt"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "uploads.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "ghcr.io",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "nodejs.org",
        "mise.jdx.dev",
        "mise-versions.jdx.dev",
        "registry.terraform.io",
        "releases.hashicorp.com",
        "hub.getdbt.com",
        "herdr.dev"
      ]
    }
  },
  "prefersReducedMotion": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh"
  }
}
