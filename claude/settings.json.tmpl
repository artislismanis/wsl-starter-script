{
  "model": "opusplan",
  "advisorModel": "opus",
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "__PERMISSION_MODE__",
    "deny": [
      "Read(//mnt/**)",
      "Edit(//mnt/**)",
      "Write(//mnt/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": ["/mnt"],
      "denyWrite": ["/mnt"]
    }
  },
  "prefersReducedMotion": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh"
  }
}
