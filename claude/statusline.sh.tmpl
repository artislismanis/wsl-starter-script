#!/bin/sh
# Claude Code statusline. Reads the JSON payload on stdin.
# Docs: https://docs.claude.com/en/docs/claude-code/statusline
# Single jq invocation, one field per line — beats six separate jq forks. We
# can't use @tsv + IFS-tab read here because POSIX `read` collapses runs of
# whitespace IFS, which would lose empty fields between two consecutive tabs.
input=$(cat)
{
  read -r model
  read -r used
  read -r total_in
  read -r total_out
  read -r five_pct
  read -r five_resets
  read -r week_pct
  read -r week_resets
} <<EOF
$(printf '%s' "$input" | jq -r '
    .model.display_name                    // "",
    .context_window.used_percentage        // "",
    .context_window.total_input_tokens     // "",
    .context_window.total_output_tokens    // "",
    .rate_limits.five_hour.used_percentage // "",
    .rate_limits.five_hour.resets_at       // "",
    .rate_limits.seven_day.used_percentage // "",
    .rate_limits.seven_day.resets_at       // ""
  ')
EOF

[ -n "$model" ] && printf '\033[00;33m[%s]\033[00m' "$model"

[ -n "$used" ] && printf ' \033[00;36mctx:%s%%\033[00m' "$(printf '%.0f' "$used")"

if [ -n "$total_in" ] || [ -n "$total_out" ]; then
    in_val=${total_in:-0}
    out_val=${total_out:-0}
    # Awk program is built by string interpolation; safe here because the
    # input is Claude Code's own statusline payload (a trusted source). If
    # this is ever repurposed for untrusted input, switch to passing values
    # through awk -v.
    in_fmt=$(awk "BEGIN { v=$in_val; if(v>=1000) printf \"%.1fk\", v/1000; else printf \"%d\", v }")
    out_fmt=$(awk "BEGIN { v=$out_val; if(v>=1000) printf \"%.1fk\", v/1000; else printf \"%d\", v }")
    printf ' \033[02;37min:%s out:%s\033[00m' "$in_fmt" "$out_fmt"
fi

# LABEL PERCENT RESETS_AT: one rate-limit window, with the time left on it.
window() {
    [ -n "$2" ] || return 0
    printf ' \033[00;35m%s:%s%%\033[00m' "$1" "$(printf '%.0f' "$2")"
    [ -n "$3" ] || return 0
    secs_left=$(( $3 - $(date +%s) ))
    if [ "$secs_left" -le 0 ]; then
        printf ' \033[02;35m(now)\033[00m'
    elif [ "$secs_left" -lt 3600 ]; then
        printf ' \033[02;35m(%dm)\033[00m' "$(( secs_left / 60 ))"
    elif [ "$secs_left" -lt 86400 ]; then
        printf ' \033[02;35m(%dh%dm)\033[00m' "$(( secs_left / 3600 ))" "$(( (secs_left % 3600) / 60 ))"
    else
        printf ' \033[02;35m(%dd%dh)\033[00m' "$(( secs_left / 86400 ))" "$(( (secs_left % 86400) / 3600 ))"
    fi
}

window 5h "$five_pct" "$five_resets"
window 7d "$week_pct" "$week_resets"

# Saved for tools that pace their work, such as herdr-workbench's workshop.
if [ -n "$five_pct$week_pct" ]; then
    state="${XDG_STATE_HOME:-$HOME/.local/state}/claude-usage.json"
    mkdir -p "$(dirname "$state")" 2>/dev/null
    if printf '%s' "$input" | jq -c --argjson at "$(date +%s)" '.rate_limits + {at: $at}' >"$state.tmp" 2>/dev/null; then
        mv -f "$state.tmp" "$state"
    fi
fi
